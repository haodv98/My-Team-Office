# Token GitHub fine-grained, quyền Read-only: Pull requests, Issues, Metadata
GITHUB_TOKEN=
# owner/repo, phân cách dấu phẩy
GITHUB_REPOS=owner/repo
# ví dụ: yourspace.backlog.com
BACKLOG_SPACE=
BACKLOG_API_KEY=
BACKLOG_PROJECT_KEY=
POLL_SECONDS=60
PORT=4800
MEMBERS_FILE=config/members.yaml
DATA_DIR=data
# HTTPS_PROXY=http://proxy:3128
AGENT_MARKERS=Generated with Claude Code
# STATUS_MAP={"Chờ QA":"done"}
